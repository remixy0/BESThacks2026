<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the Info.plist keys Xcode generates from the build settings (INFOPLIST_KEY_*).
	     This file only holds what build settings can't express. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The hackathon backend usually runs on a laptop over plain http (now http://172.20.10.6). -->
		<!-- Only this key: if NSAllowsLocalNetworking is also present, iOS ignores NSAllowsArbitraryLoads. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
